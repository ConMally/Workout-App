# Copy this file to .env.local and fill in your own Supabase project's values.
# .env.local is already gitignored — never commit real credentials.
#
# Find these under Project Settings -> API in your Supabase dashboard.
# Both are safe to expose to the browser (NEXT_PUBLIC_*): the anon key only
# grants what your Row Level Security policies allow. Never put a
# service-role key in this file or in any NEXT_PUBLIC_* variable.

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# The app currently runs entirely on localStorage — these variables are not
# required for anything to work today. See docs/SUPABASE.md.
